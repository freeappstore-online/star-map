{
  "name": "freestarmapapp",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "scripts": {
    "dev": "pnpm --filter @star-map/web dev",
    "build": "pnpm --filter @star-map/web build",
    "preview": "pnpm --filter @star-map/web preview",
    "typecheck": "pnpm --filter @star-map/web exec tsc -b",
    "test": "pnpm --filter @star-map/web test"
  },
  "repository": { "type": "git", "url": "git+https://github.com/freeappstore-online/star-map.git" }
}
